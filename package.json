{
  "name": "notes-app",
  "version": "1.0.0",
  "description": "STREEM — offline live speech translation (SeamlessStreaming)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "setup:seamless": "bash scripts/setup-seamless.sh",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/notes-app.git"
  },
  "keywords": [
    "Electron",
    "notes",
    "passwords",
    "desktop"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.notes.app",
    "productName": "STREEM",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!*.md",
      "!data.json"
    ],
    "extraResources": [
      {
        "from": "data.json",
        "to": "data.json"
      },
      {
        "from": "category.json",
        "to": "category.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  }
}
